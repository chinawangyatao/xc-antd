{
  "name": "xc-antd",
  "version": "2.2.25",
  "description": "React and Ant Design enterprise components for forms, tables and business workflows",
  "keywords": [
    "react",
    "antd",
    "ant-design",
    "typescript",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinawangyatao/xc-antd.git",
    "directory": "packages/xc-antd"
  },
  "homepage": "https://chinawangyatao.github.io/xc-antd/",
  "bugs": {
    "url": "https://github.com/chinawangyatao/xc-antd/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "source": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "xc-antd-skills": "scripts/install-skills.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style": "./src/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "scripts/install-skills.mjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.4.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "antd": "^6.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.21.0",
    "@dnd-kit/react": "^0.4.0",
    "@rc-component/util": "^1.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "react-advanced-cropper": "^0.20.1",
    "react-highlight-words": "^0.21.0",
    "swr": "^2.3.0",
    "tailwindcss": "^4.3.0"
  }
}
