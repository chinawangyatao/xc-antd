  "description": "React and Ant Design enterprise components for forms, tables and business workflows",
  "keywords": [
    "react",
    "antd",
    "ant-design",
    "typescript",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinawangyatao/xc-view.git",
